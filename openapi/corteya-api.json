  "components": {
    "schemas": {
      "PaymentSettingsRequest": {
        "type": "object",
        "properties": {
          "depositMode": {
            "type": "string",
            "enum": [
              "NONE",
              "BREB_MANUAL",
              "WOMPI"
            ]
          },
          "brebKeyType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CELULAR",
              "ALIAS",
              "CORREO",
              "DOCUMENTO"
            ]
          },
          "brebKey": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 254,
            "minLength": 0
          },
          "brebHolderName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150,
            "minLength": 0
          },
          "wompiEnvironment": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SANDBOX",
              "PRODUCTION"
            ]
          },
          "wompiPublicKey": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 0
          },
          "wompiPrivateKey": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 0
          },
          "wompiIntegritySecret": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 0
          },
          "wompiEventsSecret": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "minLength": 0
          },
          "holdMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "maximum": 1440,
            "minimum": 1
          }
        }
      },
      "PaymentSettingsResponse": {
        "type": "object",
        "properties": {
          "depositMode": {
            "type": "string",
            "enum": [
              "NONE",
              "BREB_MANUAL",
              "WOMPI"
            ]
          },
          "holdMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "brebKeyType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "CELULAR",
              "ALIAS",
              "CORREO",
              "DOCUMENTO"
            ]
          },
          "brebKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "brebHolderName": {
            "type": [
              "string",
              "null"
            ]
          },
          "wompiEnvironment": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SANDBOX",
              "PRODUCTION"
            ]
          },
          "wompiPublicKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "wompiPrivateKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "wompiIntegritySecret": {
            "type": [
              "string",
              "null"
            ]
          },
          "wompiEventsSecret": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventsUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "wompiCredentialsError": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateAppointmentRequest": {
        "type": "object",
        "properties": {
          "barberId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Instante ISO-8601 con offset obligatorio",
            "example": "2026-10-20T09:00:00-05:00"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
